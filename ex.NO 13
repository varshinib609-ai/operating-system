#include<stdio.h>

int main()
{
    int block[3]={100,500,200};
    int process[3]={90,150,180};

    printf("First Fit Allocation\n");
    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            if(block[j]>=process[i])
            {
                printf("P%d -> B%d\n",i+1,j+1);
                block[j]-=process[i];
                break;
            }
        }
    }
    return 0;
}
