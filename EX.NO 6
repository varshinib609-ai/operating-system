#include<stdio.h>

int main()
{
    int n=3;
    int bt[]={4,3,2};
    int pr[]={2,1,3};
    int p[]={1,2,3};
    int i,j,temp;

    for(i=0;i<n-1;i++)
    {
        for(j=i+1;j<n;j++)
        {
            if(pr[i]>pr[j])
            {
                temp=pr[i]; pr[i]=pr[j]; pr[j]=temp;
                temp=bt[i]; bt[i]=bt[j]; bt[j]=temp;
                temp=p[i]; p[i]=p[j]; p[j]=temp;
            }
        }
    }

    printf("Execution Order:\n");
    for(i=0;i<n;i++)
        printf("P%d ",p[i]);

    return 0;
}
